# Copy to .env and fill. NEVER commit .env
DATABASE_URL=postgresql+psycopg://tradealert:tradealert@localhost:5432/tradealert

# Shared secret. TradingView alert JSON must carry this exact value in "secret"
WEBHOOK_SECRET=change-me-to-a-long-random-string

# From @BotFather. Leave empty = demo mode (messages only print in console)
TELEGRAM_BOT_TOKEN=
# Chat id of client (or a group). Get via getUpdates after messaging the bot
TELEGRAM_CHAT_ID=

# Origins allowed to call /api/* (Dev B frontend dev server)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
